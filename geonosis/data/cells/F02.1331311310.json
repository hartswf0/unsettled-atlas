            "user_url": "https://api.openstreetmap.org/user/dannmer",
            "action": "commented",
            "text": "Are pedestrians permitted to use this road? If so, then the access needs to be changed for pedestrians and cyclists.",
            "html": "<p dir=\"auto\">Are pedestrians permitted to use this road? If so, then the access needs to be changed for pedestrians and cyclists.</p>"
          },
