            "user": "Jack the Ripper",
            "user_url": "https://api.openstreetmap.org/user/Jack%20the%20Ripper",
            "action": "commented",
            "text": "This is at least partially supported on the north and southwest legs by current street-level imagery.  I've changed the name of the southwest leg to Rainwater Boulevard.  Additional imagery is needed for the southeast leg.",
            "html": "<p dir=\"auto\">This is at least partially supported on the north and southwest legs by current street-level imagery.  I've changed the name of the southwest leg to Rainwater Boulevard.  Additional imagery is needed for the southeast leg.</p>"
